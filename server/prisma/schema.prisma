generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Business-knowledge chunks for the WhatsApp AI's retrieval-augmented replies.
// Mirrors the old Mongo `KnowledgeChunk` shape (text, embedding, source), now
// backed by pgvector so retrieval is a real ANN/exact vector query instead of
// a brute-force cosine scan in Node. The `embedding` column has no native
// Prisma type — reads/writes go through $queryRaw (see whatsapp-ai.service.ts).
model KnowledgeChunk {
  id            String                       @id @default(uuid())
  text          String
  embedding     Unsupported("vector(1536)")?
  source        String?
  createdByName String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@map("knowledge_chunks")
}

// Customer questions the AI could not answer well (it escalated, or nothing in
// the knowledge base matched). Staff turn these into new entries. One row per
// distinct question; `count` is how often it was asked.
model KnowledgeGap {
  id          String   @id @default(uuid())
  question    String
  questionKey String   @unique
  reason      String
  topScore    Float?
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  lastAskedAt DateTime @default(now())

  @@map("knowledge_gaps")
}

// What the AI learns from: staff-written replies (qa), corrections of its own
// replies (correction) and real agent replies (agent). Only approved rows with
// an embedding are retrieved. Raw SQL access (vector column).
model AiExample {
  id            String                       @id @default(uuid())
  kind          String
  question      String
  context       String?
  answer        String
  badAnswer     String?
  embedding     Unsupported("vector(1536)")?
  approved      Boolean                      @default(false)
  sourceKey     String?                      @unique
  agentName     String?
  createdByName String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @default(now()) @updatedAt

  @@index([kind, approved])
  @@map("ai_examples")
}

// Every reply the AI sent, kept so staff can review and correct it.
model AiReplyLog {
  id              String   @id @default(uuid())
  channel         String   @default("whatsapp")
  conversationId  String?
  customerName    String?
  customerMessage String
  context         String?
  aiReply         String
  escalated       Boolean  @default(false)
  topScore        Float?
  sources         String?
  status          String   @default("ok")
  correctionId    String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@map("ai_reply_logs")
}
