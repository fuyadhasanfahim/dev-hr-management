generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// Only this new WhatsApp support module lives here. Everything else in the
// app stays on MongoDB — this is a deliberate hybrid, not a migration.

model WhatsAppConversation {
  id            String   @id @default(cuid())
  channel       String   @default("whatsapp") // reserved for future channels (fb messenger, etc.)
  customerPhone String // E.164, no leading '+', matches WhatsApp "wa_id"
  customerName  String?

  status String @default("bot") // "bot" | "escalated" | "assigned" | "resolved"

  // Mongo ObjectId string of the support-app user currently owning this chat.
  // Cross-DB reference by design — Mongo stays the source of truth for users.
  assignedUserId String?
  assignedAt     DateTime?
  lastMessageAt  DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WhatsAppMessage[]

  @@index([customerPhone])
  @@index([status])
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction String // "inbound" | "outbound"
  sender    String // "customer" | "ai" | "agent"
  senderUserId String? // Mongo ObjectId string, set when sender = "agent"

  body            String
  whatsappMsgId   String? @unique
  status          String  @default("sent")

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model FaqChunk {
  id        String                 @id @default(cuid())
  source    String
  content   String
  embedding Unsupported("vector(1536)")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
